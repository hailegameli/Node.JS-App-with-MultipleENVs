# Stage 1: Build and install dependencies
FROM node:node:18 AS build    #build must be lowecase

WORKDIR /data

COPY package*.json ./

RUN npm install

# Copy your application source code into the Build stage
COPY . .

# Stage 2: Production / Runtime image
FROM node:18-alpine   #light weight and lower libraries

WORKDIR /data

ENV NODE_ENV=testing

# Copy installed dependencies from build stage
COPY --from=build /data/node_modules ./node_modules

# Copy application code from the build stage
COPY --from=build /app/package*.json ./
COPY --from=build /data/server.js ./server.js

EXPOSE 3000

CMD ["node", "server.js"]


